{
  "expo": {
    "name": "ElderTech",
    "slug": "eldertech",
    "owner": "eldertech6",
    "version": "1.0.0",
    "scheme": "eldertech",
    "orientation": "portrait",
    "icon": "./assets/images/logo-puente.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo-puente.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E3B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eldertech.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tel"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-puente.png",
        "backgroundColor": "#1B5E3B"
      },
      "package": "com.eldertech.app",
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo-puente.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "ElderTech necesita acceso al micrófono para que puedas hablar con el asistente virtual."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ElderTech necesita acceso a tus fotos para que puedas elegir una foto de perfil.",
          "cameraPermission": "ElderTech necesita acceso a la cámara para que puedas tomar una foto de perfil."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ElderTech necesita acceso a tus contactos para que puedas agregar fácilmente a tu familia y amigos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-puente.png",
          "color": "#1B5E3B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/cd37f089-a57f-4b84-975e-06c93e94c09f"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd37f089-a57f-4b84-975e-06c93e94c09f"
      }
    }
  }
}

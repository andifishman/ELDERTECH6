# Copiá este archivo a `.env.ftp` y completalo. `.env.ftp` NO se sube a git (ver .gitignore): tiene la contraseña.
FTP_HOST=147.79.84.141
FTP_USER=
FTP_PASSWORD=
# explicit = FTPS (cifrado, recomendado) · implicit · false = FTP plano (sin cifrar)
FTP_SECURE=explicit
# Carpeta del servidor donde tiene que quedar la página. Usá `npm run deploy:ftp -- --listar` para verla.
FTP_REMOTE_DIR=/

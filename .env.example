# Supabase — copiá estos valores desde tu proyecto en supabase.com
# Solo se usan para supabase.auth (login/sesión) — todo lo demás pasa por el backend.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Organización por defecto (UUID de la org "Ledor Vador" en tu Supabase)
EXPO_PUBLIC_ORG_ID=uuid-de-tu-organizacion

# Backend propio (eldertech-api) — clima, radio, asistente, tutoriales, contactos, etc.
# En dev local: http://localhost:3001 (ver backend/README o `npm run dev` en backend/)
#
# ¡OJO! Este valor es SOLO para `expo start` en tu PC. NUNCA sirve para un
# build (`eas build`) ni para una actualización OTA (`eas update`) que vaya a
# un celular real — ahí "localhost" es el celular mismo, no tu backend, y la
# app queda sin datos. Esos builds/updates toman la URL real automáticamente
# desde `.env.production` (raíz del repo, SÍ versionado a propósito — no
# toques ese archivo pensando que es un .env normal). Ver CLAUDE.md, sección
# "APK/OTA sin datos de la base".
EXPO_PUBLIC_API_URL=http://localhost:3001

# NOTA: la key de Groq (IA del asistente) ya NO va acá — vive solo en backend/.env
# (GROQ_API_KEY), nunca en una variable EXPO_PUBLIC_* que termine empaquetada en el build.

{
  "name": "eldertech-api",
  "version": "1.0.0",
  "private": true,
  "description": "ElderTech — Backend For Frontend (BFF). API propia para la app móvil y el backoffice; nunca exponer Supabase ni APIs externas directo al cliente.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:certs": "tsx scripts/exportWindowsRootCerts.ts",
    "dev": "cross-env NODE_EXTRA_CA_CERTS=./win-ca-roots.pem tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "@upstash/redis": "^1.34.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.1",
    "win-ca": "^3.5.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

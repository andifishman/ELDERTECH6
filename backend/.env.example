# ElderTech API — variables de entorno (Vercel Functions)
# Copiar a .env para desarrollo local (nunca commitear .env real)

# ── Supabase (service-role — SOLO en el backend, nunca en un cliente) ──────────
SUPABASE_URL=https://xsvysxattwoaovrmiwya.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma (backoffice en prod, localhost en dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ── Cache / estado compartido de circuit breakers ──────────────────────────
# Si se dejan vacíos, se usa un fallback en memoria (solo sirve para 1 instancia,
# no comparte estado entre invocaciones serverless — únicamente para dev local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Asistente / IA (Groq) ───────────────────────────────────────────────────
GROQ_API_KEY=
# Respaldo real (vendor distinto a Groq — si Groq se cae entero, no solo la
# cuota, esto sigue andando). Key gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Opcional — default: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=
# Slots listos, todavía sin implementar (solo hace falta la key + el provider):
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Clima — Open-Meteo no necesita key (siempre activo, tier 1). ──────────
# Respaldo real. Key gratis en https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Slots listos, todavía sin implementar:
WEATHERAPI_API_KEY=
TOMORROW_IO_API_KEY=

# ── Búsqueda externa — herramienta buscar_informacion_externa del asistente ──
# Sin esta key, la herramienta queda deshabilitada (el asistente avisa que no
# puede buscar en vez de fallar el chat entero). Key gratis (1000/mes) en
# https://tavily.com
TAVILY_API_KEY=

# ── Cron (procesamiento de notificaciones programadas/recordatorios) ────────
# Vercel inyecta esto solo como "Authorization: Bearer <valor>" en las llamadas
# de sus propios Cron Jobs — el nombre CRON_SECRET es una convención de Vercel,
# no un nombre nuestro. Generar cualquier string random y pegarlo acá y en Vercel.
CRON_SECRET=

# ── Notificaciones push (Expo) ───────────────────────────────────────────────
# Opcional — sube los límites de rate-limit de Expo Push. No hace falta para
# que funcione, solo para volúmenes altos. https://expo.dev/accounts/[cuenta]/settings/access-tokens
EXPO_ACCESS_TOKEN=
